# Copy to .env for local development. Replace every placeholder before use.
APP_ENV=development
DATABASE_URL=postgresql://registry:replace-with-local-password@localhost:5432/registry
POSTGRES_PASSWORD=replace-with-local-password
WALLET_DB_PASSWORD=replace-with-a-different-local-password
JWT_SECRET=
ADMIN_USER=initial-admin
ADMIN_PASSWORD=
# Partner credentials (routes return 503 until configured and certified)
CROSS_RIVER_WEBHOOK_SECRET=
CELTIC_WEBHOOK_SECRET=
MARQETA_WEBHOOK_USER=
MARQETA_WEBHOOK_PASS=
POLYGON_RPC_URL=
# Agent Wallet OS bridge (only use HTTPS outside loopback development)
AGENT_WALLET_URL=
AGENT_WALLET_API_KEY=
