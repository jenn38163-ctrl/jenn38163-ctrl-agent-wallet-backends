# BACKEND_URL: Base URL of the Agent Wallet Backend (Node.js/PostgreSQL).
# Android Emulator reaching a host backend on port 8080 uses http://10.0.2.2:8080
# Production deployments should set an HTTPS URL (e.g. https://your-service.up.railway.app).
BACKEND_URL=http://10.0.2.2:8080

# GEMINI_API_KEY has been moved to the backend to secure it.
# Do not store Gemini keys on the Android client.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Pimlico (ERC-4337 Bundler & Paymaster) Configuration
# PIMLICO_API_KEY=your_pimlico_api_key
# PIMLICO_CHAIN_ID=8453
