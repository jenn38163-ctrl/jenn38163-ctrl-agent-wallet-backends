# BACKEND_URL: URL of the Agent Wallet Backend.
# Set this to the production Railway URL or local development server.
BACKEND_URL=http://localhost:8080

# GEMINI_API_KEY has been moved to the backend to secure it.
# Do not store Gemini keys on the Android client.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Pimlico (ERC-4337 Bundler & Paymaster) Configuration
# PIMLICO_API_KEY=your_pimlico_api_key
# PIMLICO_CHAIN_ID=8453
