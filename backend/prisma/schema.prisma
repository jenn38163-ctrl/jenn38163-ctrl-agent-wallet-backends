// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./ledger.db"
}

// -----------------------------------------
// Institutional Double-Entry Ledger
// -----------------------------------------

model Account {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  type        String       // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  currency    String       @default("USDC")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  postings    Posting[]
}

model JournalEntry {
  id          String       @id @default(uuid())
  description String
  status      String       // PENDING, POSTED, REVERSED
  createdAt   DateTime     @default(now())
  postedAt    DateTime?
  referenceId String?      // External reference (e.g. Android transaction ID)
  
  postings    Posting[]
}

model Posting {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  amount         Decimal
  type           String       // DEBIT, CREDIT
  createdAt      DateTime     @default(now())

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  account        Account      @relation(fields: [accountId], references: [id])
}

// -----------------------------------------
// Agent Policies & Authorization
// -----------------------------------------

model AgentPolicy {
  id             String       @id @default(uuid())
  agentId        String       @unique
  monthlyLimit   Decimal
  perTxLimit     Decimal
  allowedVendors String       // Comma-separated or JSON
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// -----------------------------------------
// Transaction Intents & Audit Chain
// -----------------------------------------

model TransactionIntent {
  id              String       @id @default(uuid())
  agentId         String
  vendor          String
  amount          Decimal
  currency        String       @default("USDC")
  status          String       // PENDING, AUTHORIZED, SETTLED, FAILED
  idempotencyKey  String       @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  auditLogs       AuditLog[]
}

model AuditLog {
  id                  String             @id @default(uuid())
  transactionIntentId String
  eventType           String             // e.g., POLICY_CHECK, LEDGER_POST, SETTLEMENT_BROADCAST
  description         String
  status              String             // SUCCESS, FAILURE
  timestamp           DateTime           @default(now())
  cryptographicHash   String?            // Stub for real hash chaining

  transactionIntent   TransactionIntent  @relation(fields: [transactionIntentId], references: [id])
}
